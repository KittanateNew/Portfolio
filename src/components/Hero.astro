---
interface Props {
  name: string;
  headline: string;
  personality: string;
  location: string;
}
const { name, headline, personality, location } = Astro.props;
/** The display size suits a few short words; step it down for longer headlines so it never overflows the first screen. */
const size = headline.length > 48 ? 'long' : headline.length > 28 ? 'medium' : undefined;
/** Short multi-sentence headlines ("Manual in. Automated out.") get one sentence per line, sized so the longest line fits. */
const lines = size ? [headline] : headline.split(/(?<=[.!?])\s+/).filter(Boolean);
const longest = Math.max(...lines.map((l) => l.length));
const longestWord = Math.max(...headline.split(/\s+/).map((w) => w.length));
---

<section class="hero container-x" aria-labelledby="hero-title">
  <p class="eyebrow hero__top" data-fade>
    <span>{name}</span>
    <span>{location}</span>
  </p>

  <h1
    id="hero-title"
    class="display hero__title"
    data-size={size ?? (lines.length > 1 ? 'lines' : undefined)}
    style={lines.length > 1 ? `--chars:${longest};--word-chars:${longestWord}` : undefined}
    data-reveal
  >
    {lines.map((l, i) => (i > 0 ? [<br />, l] : l))}
  </h1>

  <div class="hero__bottom">
    {personality && <p class="hero__fact" data-fade><span class="eyebrow">Fun fact</span> {personality}</p>}
    <a href="#about" class="hero__scroll eyebrow" data-fade data-cursor="Scroll">
      Scroll <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<script>
  import { onPageLoad, revealText, fadeUp, whenIntroDone, stagger } from '../lib/motion';

  onPageLoad((ctx) => {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    whenIntroDone().then(() =>
      ctx.add(() => {
        revealText(hero.querySelector('.hero__title')!, { by: 'chars', scroll: false });
        fadeUp(hero.querySelectorAll('[data-fade]'), { scroll: false, delay: 0.35, each: stagger.loose });
      })
    );
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    padding-block: calc(var(--spacing-nav) + 1rem) 2rem;
  }
  .hero__top {
    display: flex;
    justify-content: space-between;
    color: var(--color-muted);
  }
  .hero__title {
    align-self: center;
    max-width: 14ch;
    /* Let one short word fill the width without overflowing on narrow screens. */
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .hero__title[data-size='lines'] {
    max-width: none;
    white-space: nowrap;
    /* Longest line fills the width (≈0.6em per uppercase glyph, measured), capped by the display size and the screen height. */
    font-size: min(
      var(--text-display),
      calc((100vw - 2 * var(--spacing-gutter)) / (var(--chars) * 0.6)),
      30svh
    );
  }
  /* Phones: let the lines wrap and size by the longest word instead (wide glyphs like M run ≈0.65em), so it stays big without breaking a word. */
  @media (max-width: 640px) {
    .hero__title[data-size='lines'] {
      white-space: normal;
      font-size: min(var(--text-display), calc((100vw - 2 * var(--spacing-gutter)) / (var(--word-chars) * 0.72)));
    }
  }
  .hero__title[data-size='medium'] {
    max-width: 18ch;
    font-size: clamp(3rem, 0.5rem + 9vw, 11rem);
  }
  .hero__title[data-size='long'] {
    max-width: 22ch;
    font-size: var(--text-4xl);
  }
  .hero__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .hero__fact {
    max-width: 34ch;
    font-size: var(--text-lg);
    line-height: 1.35;
  }
  .hero__fact .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
  }
  .hero__scroll span {
    display: inline-block;
    animation: nudge 1.8s var(--ease-in-out-expo) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(0.35em);
    }
  }
</style>
