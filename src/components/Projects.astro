---
import { Picture } from 'astro:assets';
import type { ProjectView } from '../lib/types';
import { year } from '../lib/types';

interface Props {
  projects: ProjectView[];
}
const { projects } = Astro.props;
---

<section id="work" class="work container-x" aria-labelledby="work-title">
  <div class="work__head">
    <h2 id="work-title" class="eyebrow">(04) Selected work</h2>
    <p class="eyebrow work__count">{String(projects.length).padStart(2, '0')} projects</p>
  </div>

  <ul class="work__grid">
    {
      projects.map((p, i) => (
        <li class:list={['work__item', { 'is-wide': p.featured && i === 0 }]} data-fade>
          <a href={`/projects/${p.slug}`} class="work__card" data-cursor="View">
            {p.cover && (
              <div class="work__media">
                <Picture
                  src={p.cover}
                  alt=""
                  widths={[480, 800, 1200, 1600]}
                  sizes={p.featured && i === 0 ? '(max-width: 767px) 100vw, 92vw' : '(max-width: 767px) 100vw, 46vw'}
                  formats={['avif', 'webp']}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  transition:name={`cover-${p.slug}`}
                />
              </div>
            )}
            <div class="work__meta">
              <h3 class="work__title">{p.title}</h3>
              <span class="eyebrow work__year">{year(p.date)}</span>
            </div>
            <p class="work__summary">{p.summary}</p>
            {p.tech.length > 0 && <p class="eyebrow work__tech">{p.tech.join(' · ')}</p>}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { onPageLoad, fadeUp } from '../lib/motion';

  onPageLoad(() => {
    document.querySelectorAll<HTMLElement>('.work [data-fade]').forEach((el) => fadeUp(el, { y: 48 }));
  });
</script>

<style>
  .work {
    padding-block: 0 var(--spacing-section);
  }
  .work__head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 3rem;
    color: var(--color-muted);
  }
  .work__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem var(--spacing-gutter);
  }
  .work__item.is-wide {
    grid-column: 1 / -1;
  }
  .work__card {
    display: block;
  }
  .work__media {
    overflow: hidden;
    border-radius: 0.6rem;
    background: var(--color-paper-deep);
  }
  .work__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: scale var(--dur-slow) var(--ease-out-expo);
  }
  .is-wide .work__media :global(img) {
    aspect-ratio: 16 / 8;
  }
  .work__card:hover .work__media :global(img),
  .work__card:focus-visible .work__media :global(img) {
    scale: 1.04;
  }
  .work__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .work__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .work__year {
    color: var(--color-muted);
  }
  .work__summary {
    max-width: 52ch;
    margin-top: 0.75rem;
  }
  .work__tech {
    margin-top: 1rem;
    color: var(--color-muted);
  }
  @media (max-width: 767px) {
    .work__grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .is-wide .work__media :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
