---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { Renderer } from '@astrojs/markdoc/components';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/reader';
import { monthYear, type ProjectView } from '../../lib/types';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    // Wrap around so the last project links back to the first.
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectView;
  next?: ProjectView;
}
const { project, next } = Astro.props;
---

<Base title={project.title} description={project.summary}>
  <article class="project">
    <header class="project__head container-x">
      <a href="/#work" class="eyebrow link-draw project__back">← All work</a>
      <h1 class="display project__title" data-reveal>{project.title}</h1>
      <div class="project__intro">
        <p class="project__summary" data-fade>{project.summary}</p>
        <dl class="project__facts eyebrow" data-fade>
          <div><dt>Date</dt><dd>{monthYear(project.date)}</dd></div>
          {project.tech.length > 0 && <div><dt>Built with</dt><dd>{project.tech.join(', ')}</dd></div>}
          {(project.liveUrl || project.repoUrl) && (
            <div>
              <dt>Links</dt>
              <dd class="project__links">
                {project.liveUrl && <a class="link-draw" href={project.liveUrl} target="_blank" rel="noopener">Live site ↗</a>}
                {project.repoUrl && <a class="link-draw" href={project.repoUrl} target="_blank" rel="noopener">Code ↗</a>}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    {
      project.cover && (
        <div class="project__cover container-x">
          <Picture
            src={project.cover}
            alt=""
            widths={[640, 1024, 1600, 2200]}
            sizes="100vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            transition:name={`cover-${project.slug}`}
          />
        </div>
      )
    }

    <div class="project__body prose container-x" data-fade>
      <Renderer config={{}} stringifiedAst={project.bodyAst} />
    </div>

    {
      project.gallery.length > 0 && (
        <ul class="project__gallery container-x">
          {project.gallery.map((g) => (
            <li data-fade>
              <Picture src={g.src!} alt={g.alt} widths={[640, 1024, 1600]} sizes="(max-width: 767px) 100vw, 80vw" formats={['avif', 'webp']} loading="lazy" />
            </li>
          ))}
        </ul>
      )
    }

    {
      next && (
        <a href={`/projects/${next.slug}`} class="project__next on-ink container-x" data-cursor="Next">
          <span class="eyebrow">Next project</span>
          <span class="display project__next-title">{next.title}</span>
        </a>
      )
    }
  </article>
</Base>

<script>
  import { onPageLoad, revealText, fadeUp } from '../../lib/motion';

  onPageLoad(() => {
    const page = document.querySelector<HTMLElement>('.project');
    if (!page) return;
    revealText(page.querySelector('.project__title')!, { by: 'chars', scroll: false });
    page.querySelectorAll<HTMLElement>('[data-fade]').forEach((el) => fadeUp(el));
  });
</script>

<style>
  .project__head {
    padding-top: calc(var(--spacing-nav) + 3rem);
  }
  .project__back {
    color: var(--color-muted);
  }
  .project__title {
    margin-top: 2rem;
    font-size: clamp(3rem, 0.5rem + 11vw, 14rem);
    overflow-wrap: break-word;
  }
  .project__intro {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: calc(var(--spacing-gutter) * 2);
    margin-block: 3rem 4rem;
  }
  .project__summary {
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .project__facts {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .project__facts dt {
    color: var(--color-muted);
  }
  .project__facts dd {
    margin-top: 0.25rem;
  }
  .project__links {
    display: flex;
    gap: 1.25rem;
  }
  .project__cover :global(img) {
    width: 100%;
    max-height: 85svh;
    object-fit: cover;
    border-radius: 0.6rem;
  }

  .prose {
    max-width: calc(68ch + var(--spacing-gutter) * 2);
    margin-inline: auto;
    padding-block: var(--spacing-section) 0;
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .prose :global(h2) {
    margin-block: 2.5em 0.6em;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin-block: 2em 0.5em;
    font-weight: 600;
  }
  .prose :global(p + p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.25em;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.25em;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .project__gallery {
    display: grid;
    gap: var(--spacing-gutter);
    padding-top: var(--spacing-section);
  }
  .project__gallery :global(img) {
    width: 100%;
    border-radius: 0.6rem;
  }

  .project__next {
    display: grid;
    gap: 1rem;
    margin-top: var(--spacing-section);
    padding-block: calc(var(--spacing-section) * 0.6);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .project__next .eyebrow {
    color: var(--color-muted-on-ink);
  }
  .project__next-title {
    font-size: var(--text-4xl);
    transition: color var(--dur-fast) var(--ease-soft);
  }
  .project__next:hover .project__next-title {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .project__intro {
      grid-template-columns: 1fr;
    }
  }
</style>
